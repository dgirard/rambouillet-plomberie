---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import OpenStreetMap from '../components/ui/OpenStreetMap.astro';

const breadcrumbs = [
  { label: 'Contact' }
];

const services = [
  'Fuite d\'eau',
  'Problème de chaudière',
  'Débouchage canalisation',
  'Rénovation salle de bain',
  'Installation sanitaires',
  'Autre demande'
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Plombier Rambouillet",
  "description": "Contactez votre plombier à Rambouillet pour un devis gratuit. Urgences 24h/24, intervention rapide.",
  "mainEntity": {
    "@type": "Plumber",
    "name": "Plomberie Rambouillet Services",
    "telephone": "+33627313870",
    "email": "S.depannage.plomberie@gmail.com",
    "areaServed": {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": 48.6439,
        "longitude": 1.8308
      },
      "geoRadius": "30000"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  }
};
---

<Layout
  title="Contact Plombier Rambouillet | Devis Gratuit & Urgences 24h/24"
  description="Contactez votre plombier à Rambouillet pour un devis gratuit. Urgences 24h/24, intervention en 30 minutes. Tél: 06 27 31 38 70"
  schema={contactSchema}
>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 overflow-hidden bg-white border-b border-gray-200">
    <div class="absolute -top-20 -right-20 -z-10 h-96 w-96 rounded-full bg-blue-100/50 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 -z-10 h-96 w-96 rounded-full bg-gray-200/50 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />

      <header class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-600 border border-blue-100 mb-4">
          <span class="flex h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
          Devis Gratuit
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight">
          Contactez-nous
        </h1>
        <p class="mt-4 text-lg text-gray-600 max-w-xl">
          Une urgence ou un projet de rénovation ? Notre équipe intervient à Rambouillet et ses alentours. Réponse garantie sous 24h.
        </p>
      </header>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-12 lg:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">

        <!-- Left Column: Contact Info -->
        <aside class="flex flex-col gap-6 lg:col-span-5">

          <!-- Emergency Card -->
          <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm border-l-4 border-red-600">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-red-600">Urgence Plomberie</p>
                <h3 class="mt-1 text-2xl font-black tracking-tight text-gray-900">24h/24 et 7j/7</h3>
              </div>
              <svg class="w-10 h-10 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <p class="mt-2 text-sm text-gray-600">Intervention rapide en 30 minutes pour fuites et débouchages.</p>
            <a
              href="tel:+33627313870"
              class="mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-red-600 px-4 py-3 text-base font-bold text-white transition-all hover:bg-red-700 shadow-lg shadow-red-500/20"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              06 27 31 38 70
            </a>
          </div>

          <!-- Details Card -->
          <div class="flex flex-col gap-8 rounded-2xl bg-white p-8 shadow-sm">
            <div class="space-y-6">

              <!-- Email -->
              <div class="flex gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-gray-900">Email</p>
                  <a class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors" href="mailto:S.depannage.plomberie@gmail.com">
                    S.depannage.plomberie@gmail.com
                  </a>
                </div>
              </div>

              <!-- Zone -->
              <div class="flex gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-gray-900">Zone d'intervention</p>
                  <p class="text-sm font-medium text-gray-600">Rambouillet + 30km alentours</p>
                </div>
              </div>

              <!-- Social -->
              <div class="flex gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-yellow-50 text-yellow-600">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-gray-900">Snapchat</p>
                  <p class="text-sm font-medium text-gray-600">
                    <span class="font-bold text-gray-900">@souleydepannage</span>
                  </p>
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="flex gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-gray-900">WhatsApp</p>
                  <a href="https://wa.me/33627313870" class="text-sm font-medium text-green-600 hover:text-green-700 transition-colors">
                    Envoyer un message
                  </a>
                </div>
              </div>
            </div>

            <!-- Map OpenStreetMap -->
            <div class="h-48 w-full overflow-hidden rounded-xl">
              <OpenStreetMap lat={48.6439} lon={1.8308} cityName="Rambouillet" zoom={12} />
            </div>
          </div>
        </aside>

        <!-- Right Column: Form -->
        <section class="lg:col-span-7">
          <div class="rounded-2xl bg-white p-6 sm:p-10 shadow-sm h-full">
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-gray-900">Demande de devis</h2>
              <p class="text-sm text-gray-600">Remplissez le formulaire ci-dessous. C'est gratuit et sans engagement.</p>
            </div>

            <form
              action="mailto:S.depannage.plomberie@gmail.com"
              method="POST"
              enctype="text/plain"
              class="space-y-6"
            >
              <div class="grid gap-6 md:grid-cols-2">
                <!-- Name -->
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-900" for="name">Nom & Prénom</label>
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    </div>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-3 pl-10 text-sm text-gray-900 placeholder:text-gray-400 focus:border-blue-600 focus:ring-blue-600"
                      placeholder="Jean Dupont"
                    />
                  </div>
                </div>

                <!-- Phone -->
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-900" for="phone">Téléphone</label>
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-3 pl-10 text-sm text-gray-900 placeholder:text-gray-400 focus:border-blue-600 focus:ring-blue-600"
                      placeholder="06 00 00 00 00"
                    />
                  </div>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <!-- Email -->
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-900" for="email">Adresse e-mail</label>
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                      </svg>
                    </div>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-3 pl-10 text-sm text-gray-900 placeholder:text-gray-400 focus:border-blue-600 focus:ring-blue-600"
                      placeholder="jean@exemple.fr"
                    />
                  </div>
                </div>

                <!-- Service Type -->
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-900" for="service">Type de service</label>
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <select
                      id="service"
                      name="service"
                      required
                      class="block w-full appearance-none rounded-lg border border-gray-300 bg-gray-50 p-3 pl-10 pr-10 text-sm text-gray-900 focus:border-blue-600 focus:ring-blue-600"
                    >
                      <option value="" disabled selected>Sélectionnez une option</option>
                      {services.map((service) => (
                        <option value={service}>{service}</option>
                      ))}
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Message -->
              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-900" for="message">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-blue-600 focus:ring-blue-600 resize-none"
                  placeholder="Décrivez votre problème en quelques mots..."
                ></textarea>
              </div>

              <!-- GDPR Checkbox -->
              <div class="flex items-start gap-3 py-2">
                <div class="flex h-6 items-center">
                  <input
                    type="checkbox"
                    id="gdpr"
                    name="gdpr"
                    required
                    class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600"
                  />
                </div>
                <div class="text-sm leading-6">
                  <label class="font-medium text-gray-900" for="gdpr">Consentement des données</label>
                  <p class="text-gray-600 text-xs">
                    J'accepte que mes données soient traitées pour cette demande de devis conformément à la
                    <a href="/mentions-legales" class="text-blue-600 hover:underline">politique de confidentialité</a>.
                  </p>
                </div>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="group flex w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-4 text-base font-bold text-white transition-all hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/25 active:scale-[0.99]"
              >
                <span>Envoyer ma demande</span>
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
              </button>

              <!-- Trust Badges -->
              <div class="mt-4 flex items-center justify-center gap-6 pt-4 border-t border-dashed border-gray-200">
                <div class="flex items-center gap-1 opacity-70">
                  <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-xs font-semibold text-gray-600">Artisan Certifié</span>
                </div>
                <div class="flex items-center gap-1 opacity-70">
                  <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-xs font-semibold text-gray-600">Assurance Décennale</span>
                </div>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">Questions Fréquentes</h2>
        <p class="mt-2 text-gray-600">Tout ce que vous devez savoir sur nos services</p>
      </div>

      <div class="space-y-4">
        <details class="group bg-white rounded-lg shadow-sm border border-gray-200">
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 font-semibold text-gray-900">
            <span>Comment demander un devis ?</span>
            <svg class="w-5 h-5 text-gray-500 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-gray-600">
            Vous pouvez demander un devis gratuit en remplissant le formulaire ci-dessus, en nous appelant au 06 27 31 38 70, ou en nous contactant sur WhatsApp. Nous vous répondons sous 24h maximum.
          </div>
        </details>

        <details class="group bg-white rounded-lg shadow-sm border border-gray-200">
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 font-semibold text-gray-900">
            <span>Intervenez-vous en urgence le week-end ?</span>
            <svg class="w-5 h-5 text-gray-500 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-gray-600">
            Oui, nous intervenons 24h/24 et 7j/7 pour toutes les urgences plomberie : fuites d'eau, débouchages, pannes de chaudière. Appelez-nous directement au 06 27 31 38 70.
          </div>
        </details>

        <details class="group bg-white rounded-lg shadow-sm border border-gray-200">
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 font-semibold text-gray-900">
            <span>Quelle est votre zone d'intervention ?</span>
            <svg class="w-5 h-5 text-gray-500 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-gray-600">
            Nous intervenons à Rambouillet et dans un rayon de 30km : Gazeran, Le Perray-en-Yvelines, Clairefontaine-en-Yvelines, Sonchamp, Saint-Arnoult-en-Yvelines, Chevreuse, et toutes les communes environnantes.
          </div>
        </details>

        <details class="group bg-white rounded-lg shadow-sm border border-gray-200">
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-4 font-semibold text-gray-900">
            <span>Acceptez-vous les paiements en plusieurs fois ?</span>
            <svg class="w-5 h-5 text-gray-500 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-gray-600">
            Pour les travaux importants (rénovation de salle de bain, remplacement de chaudière), nous proposons des facilités de paiement. Contactez-nous pour en discuter.
          </div>
        </details>
      </div>
    </div>
  </section>
</Layout>
