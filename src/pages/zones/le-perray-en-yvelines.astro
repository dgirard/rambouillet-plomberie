---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import OpenStreetMap from '../../components/ui/OpenStreetMap.astro';

const city = {
  name: 'Le Perray-en-Yvelines',
  postalCode: '78610',
  lat: 48.6878,
  lon: 1.8539,
  interventionTime: '25 min',
  description: 'Urgence plomberie au Perray-en-Yvelines ? Nos artisans qualifiés interviennent 24h/24 pour fuites d\'eau, débouchage et dépannage chaudière. Devis gratuit.',
  quartiers: ['Centre-ville', 'Gare du Perray', 'Les Essarts', 'Le Corbet', 'La Boissière', 'Les Closeaux'],
  nearCities: ['Rambouillet', 'Auffargis', 'Les Essarts-le-Roi', 'Gazeran']
};

const breadcrumbs = [
  { label: 'Zones', href: '/zones' },
  { label: city.name }
];

const services = [
  {
    icon: 'water',
    title: 'Recherche de Fuite',
    description: 'Détection précise sans casse grâce à nos caméras thermiques. Intervention rapide pour limiter les dégâts des eaux.'
  },
  {
    icon: 'plumbing',
    title: 'Débouchage WC & Canalisation',
    description: 'Canalisations bouchées ? Nous intervenons avec camion pompe haute pression si nécessaire. Résultat garanti.'
  },
  {
    icon: 'heating',
    title: 'Chauffe-eau',
    description: 'Installation, entretien et dépannage de votre ballon d\'eau chaude. Remplacement de résistance et thermostat.'
  }
];

const trustBadges = [
  { icon: 'location', title: 'Artisan 100% Local', description: 'Nous connaissons chaque quartier du Perray.' },
  { icon: 'euro', title: 'Tarifs Transparents', description: 'Aucune surprise : devis annoncé et validé avant travaux.' },
  { icon: 'shield', title: 'Garantie Décennale', description: 'Toutes nos interventions sont couvertes et garanties.' }
];

const testimonial = {
  text: "Intervention très professionnelle pour un problème de chauffe-eau. Diagnostic rapide, réparation efficace. Tarif conforme au devis. Très satisfait !",
  author: "Philippe R.",
  location: "Résident Le Perray-en-Yvelines",
  initials: "PR",
  rating: 5
};

const faq = [
  {
    question: 'Quel est le délai d\'intervention au Perray-en-Yvelines ?',
    answer: 'Nous intervenons en moyenne en ' + city.interventionTime + ' au Perray-en-Yvelines. Pour les urgences, nous avons un technicien disponible 24h/24.'
  },
  {
    question: 'Intervenez-vous les week-ends et jours fériés ?',
    answer: 'Oui, notre service d\'urgence est disponible 7j/7, 24h/24. Une majoration de 50% s\'applique pour les interventions de nuit et week-end.'
  },
  {
    question: 'Proposez-vous des devis gratuits ?',
    answer: 'Oui, tous nos devis sont gratuits et sans engagement. Pour les urgences, nous vous donnons un prix avant intervention.'
  }
];

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Plumber",
  "name": "Plombier Le Perray-en-Yvelines",
  "description": "Artisan plombier plombier au Perray-en-Yvelines (78). Dépannage urgence 24/7, rénovation salle de bain.",
  "telephone": "+33627313870",
  "areaServed": {
    "@type": "City",
    "name": city.name,
    "postalCode": city.postalCode
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city.name,
    "postalCode": city.postalCode,
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  }
};
---

<Layout
  title={`Plombier ${city.name} (${city.postalCode}) - Dépannage Urgence 24/7 | Intervention ${city.interventionTime}`}
  description={`Artisan plombier au ${city.name}. Urgence fuite d'eau, débouchage, chauffe-eau. Intervention en ${city.interventionTime}. Devis gratuit. Appelez le 06 27 31 38 70`}
  schema={localSchema}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-24 lg:pb-32 bg-white overflow-hidden">
    <div class="absolute -top-20 -right-20 -z-10 h-96 w-96 rounded-full bg-blue-100/50 blur-3xl"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="flex flex-col gap-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 w-fit mx-auto lg:mx-0">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-600 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
            </span>
            <span class="text-xs font-bold text-blue-600 uppercase tracking-wide">Disponible immédiatement au {city.name}</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 leading-tight">
            Plombier {city.name} : <br />
            <span class="text-blue-600">Dépannage en {city.interventionTime}</span>
          </h1>

          <p class="text-lg text-gray-600 max-w-xl mx-auto lg:mx-0 leading-relaxed">
            {city.description}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4">
            <a
              href="tel:+33627313870"
              class="flex items-center justify-center gap-3 px-8 py-4 bg-red-600 text-white rounded-xl font-bold text-lg shadow-lg hover:bg-red-700 transition-all transform hover:-translate-y-1"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Appeler 06 27 31 38 70
            </a>
            <a
              href="https://wa.me/33627313870?text=Bonjour%2C%20j%27ai%20besoin%20d%27un%20plombier%20au%20Perray-en-Yvelines"
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-3 px-8 py-4 bg-green-500 text-white rounded-xl font-bold text-lg shadow-lg hover:bg-green-600 transition-all transform hover:-translate-y-1"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Devis WhatsApp
            </a>
          </div>

          <div class="flex items-center justify-center lg:justify-start gap-6 pt-4 text-sm text-gray-500 font-medium">
            <div class="flex items-center gap-1.5">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Devis Gratuit</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Agréé Assurances</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Artisan Local</span>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-2xl blur-2xl opacity-70"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20">
            <div class="aspect-[4/3] w-full bg-gray-200">
              <img
                src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=800&h=600&fit=crop"
                alt={`Plombier professionnel au ${city.name}`}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-sm p-4 rounded-xl shadow-lg border border-gray-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-gray-900 leading-tight">4.9/5 Excellent</p>
                  <p class="text-xs text-gray-500">Basé sur 150+ avis</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="border-y border-gray-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {trustBadges.map((badge) => (
          <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-gray-50 transition-colors">
            <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
              {badge.icon === 'location' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
              {badge.icon === 'euro' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 15.536c-1.171 1.952-3.07 1.952-4.242 0-1.172-1.953-1.172-5.119 0-7.072 1.171-1.952 3.07-1.952 4.242 0M8 10.5h4m-4 3h4m9-1.5a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              )}
              {badge.icon === 'shield' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900">{badge.title}</h3>
              <p class="text-sm text-gray-500 mt-1">{badge.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-4">Nos Interventions au {city.name}</h2>
        <p class="text-gray-500 text-lg">Nous traitons toutes les urgences de plomberie, du simple joint à la rénovation complète.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100">
            <div class="h-48 w-full rounded-xl overflow-hidden mb-6 relative bg-gray-100">
              {service.icon === 'water' && (
                <img src="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=400&h=300&fit=crop" alt={service.title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" />
              )}
              {service.icon === 'plumbing' && (
                <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=400&h=300&fit=crop" alt={service.title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" />
              )}
              {service.icon === 'heating' && (
                <img src="https://images.unsplash.com/photo-1585771724684-38269d6639fd?w=400&h=300&fit=crop" alt={service.title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" />
              )}
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
            <p class="text-gray-500 text-sm mb-6">{service.description}</p>
            <a href="/urgences" class="inline-flex items-center text-blue-600 font-bold text-sm hover:underline">
              En savoir plus
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zone Coverage Section -->
  <section class="py-20 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-600 uppercase tracking-wide">Zone d'intervention</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6">Plombier de proximité au {city.name}</h2>
          <p class="text-gray-500 text-lg mb-8">
            Notre positionnement central nous permet d'être sur place très rapidement au {city.name}. Plus besoin d'attendre un plombier venant de Versailles ou Paris.
          </p>
          <div class="mb-8">
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Quartiers desservis :</h3>
            <div class="flex flex-wrap gap-2">
              {city.quartiers.map((quartier) => (
                <span class="px-3 py-1.5 bg-white border border-gray-200 rounded-md text-sm text-gray-600 shadow-sm">{quartier}</span>
              ))}
            </div>
          </div>
          <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="bg-blue-100 p-2 rounded-lg text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Horaires d'ouverture</h4>
                <p class="text-sm text-gray-500 mt-1">Lundi - Samedi : 08h00 - 19h00</p>
                <p class="text-sm font-bold text-red-600 mt-1">Urgences : 24h/24 et 7j/7</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Map OpenStreetMap -->
        <OpenStreetMap lat={city.lat} lon={city.lon} cityName={city.name} />
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-black text-gray-900">Avis Clients {city.name}</h2>
        <p class="text-gray-500 mt-2">La satisfaction de nos voisins est notre meilleure publicité.</p>
      </div>
      <div class="bg-gray-900 p-8 md:p-12 rounded-2xl shadow-lg text-white relative overflow-hidden">
        <div class="absolute top-8 right-12 opacity-10">
          <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
        </div>
        <div class="flex flex-col items-center text-center gap-6 relative z-10">
          <div class="flex gap-1 text-yellow-400">
            {[...Array(testimonial.rating)].map(() => (
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <blockquote class="text-xl md:text-2xl font-medium leading-relaxed">
            "{testimonial.text}"
          </blockquote>
          <div class="flex items-center gap-4 mt-2">
            <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center font-bold text-sm">{testimonial.initials}</div>
            <div class="text-left">
              <div class="font-bold text-sm">{testimonial.author}</div>
              <div class="text-sm text-gray-400">{testimonial.location}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-black text-gray-900">Questions Fréquentes</h2>
      </div>
      <FAQAccordion items={faq} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-blue-600 py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Besoin d'un plombier maintenant ?</h2>
      <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">Ne laissez pas une petite fuite devenir un dégât des eaux majeur. Notre équipe est prête à intervenir au {city.name}.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:+33627313870"
          class="flex items-center justify-center gap-3 px-8 py-4 bg-white text-blue-600 rounded-xl font-bold text-lg shadow-lg hover:bg-gray-100 transition-all"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Appeler le 06 27 31 38 70
        </a>
        <a
          href="/contact"
          class="flex items-center justify-center gap-3 px-8 py-4 bg-transparent border-2 border-white text-white rounded-xl font-bold text-lg hover:bg-white/10 transition-all"
        >
          Demander un rappel
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  <section class="py-12 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Nous intervenons également dans les communes voisines :</h3>
      <div class="flex flex-wrap gap-3">
        {city.nearCities.map((nearCity) => (
          <a href={`/zones/${nearCity.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '')}`} class="px-4 py-2 bg-gray-100 hover:bg-blue-50 text-gray-700 hover:text-blue-600 rounded-lg text-sm font-medium transition-colors">
            Plombier {nearCity}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
