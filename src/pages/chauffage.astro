---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import PricingTable from '../components/ui/PricingTable.astro';
import SidebarContact from '../components/ui/SidebarContact.astro';

const breadcrumbs = [
  { label: 'Chauffage' }
];

const services = [
  { title: 'Entretien chaudière gaz', description: 'Contrat annuel obligatoire' },
  { title: 'Entretien chaudière fioul', description: 'Nettoyage et réglage complet' },
  { title: 'Remplacement chaudière', description: 'Installation HPE nouvelle génération' },
  { title: 'Dépannage chauffage', description: 'Diagnostic et réparation rapide' },
  { title: 'Désembouage circuit', description: 'Nettoyage des radiateurs' },
  { title: 'Installation radiateurs', description: 'Pose et raccordement' }
];

const whyChooseUs = [
  {
    icon: 'certificate',
    title: 'Certification RGE',
    description: 'Qualifié RGE (Reconnu Garant de l\'Environnement) pour vos aides financières MaPrimeRénov\' et CEE.'
  },
  {
    icon: 'brands',
    title: 'Multi-Marques',
    description: 'Formés et agréés par les plus grandes marques : Saunier Duval, De Dietrich, Viessmann, Frisquet.'
  },
  {
    icon: 'contract',
    title: 'Contrat d\'entretien',
    description: 'Forfait annuel incluant visite de maintenance, attestation obligatoire et dépannage prioritaire.'
  },
  {
    icon: 'eco',
    title: 'Conseils Économies',
    description: 'Optimisation de votre installation pour réduire vos factures d\'énergie jusqu\'à 30%.'
  }
];

const pricing = [
  { service: 'Entretien chaudière gaz', details: 'Nettoyage + Réglages + Attestation', price: '119€' },
  { service: 'Entretien chaudière fioul', details: 'Nettoyage complet + Réglages', price: '169€' },
  { service: 'Contrat entretien annuel', details: 'Visite + Dépannage prioritaire', price: 'dès 15€/mois' },
  { service: 'Désembouage circuit', details: 'Traitement chimique + Rinçage', price: 'Sur devis' },
  { service: 'Majoration Urgence', details: 'Dépannage le jour même', price: '+30%', isUrgent: true }
];

const faq = [
  {
    question: 'L\'entretien de ma chaudière est-il obligatoire ?',
    answer: 'Oui, l\'entretien annuel de votre chaudière gaz ou fioul est obligatoire depuis 2009 (décret n°2009-649). Nous vous fournissons une attestation à conserver et présenter en cas de sinistre.'
  },
  {
    question: 'Quelles aides pour changer ma chaudière ?',
    answer: 'En tant qu\'artisan RGE, nos installations ouvrent droit à MaPrimeRénov\', aux Certificats d\'Économie d\'Énergie (CEE), et parfois aux aides locales. Nous vous accompagnons dans vos démarches.'
  },
  {
    question: 'Ma chaudière fait du bruit, est-ce grave ?',
    answer: 'Un bruit inhabituel peut indiquer un problème d\'embouage, une pompe défaillante, ou un réglage à ajuster. Contactez-nous pour un diagnostic avant que la panne ne s\'aggrave.'
  },
  {
    question: 'Combien de temps dure un entretien de chaudière ?',
    answer: 'Un entretien standard dure entre 45 minutes et 1 heure. Il comprend le nettoyage du brûleur, la vérification des organes de sécurité, le réglage de la combustion et l\'analyse des fumées.'
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Entretien et Installation Chaudière Rambouillet",
  "description": "Artisan chauffagiste RGE à Rambouillet : entretien annuel chaudière gaz/fioul, remplacement, dépannage. Devis gratuit pour installation HPE.",
  "provider": {
    "@type": "Plumber",
    "@id": "https://www.rambouillet-plomberie.fr/#organization"
  },
  "areaServed": {
    "@type": "City",
    "name": "Rambouillet"
  },
  "serviceType": "Heating System Service"
};
---

<Layout
  title="Chauffagiste Rambouillet - Entretien Chaudière RGE | Plomberie Rambouillet"
  description="Chauffagiste RGE à Rambouillet : entretien chaudière gaz/fioul dès 119€, installation HPE, dépannage rapide. Aides MaPrimeRénov'. Appelez le 06 27 31 38 70"
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <div class="bg-white border-b border-gray-200 pb-12 pt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />

      <div class="flex flex-col lg:flex-row gap-12 items-start">
        <!-- Text Content -->
        <div class="flex-1 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-100">
            <svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-xs font-bold text-orange-600 uppercase tracking-wider">Artisan Certifié RGE</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Chauffagiste Expert <br class="hidden md:block" /> <span class="text-orange-600">à Rambouillet</span>
          </h1>

          <p class="text-lg text-gray-600 max-w-2xl leading-relaxed">
            Entretien, installation et dépannage de chaudières gaz et fioul. Artisan RGE pour bénéficier des aides MaPrimeRénov'. Devis gratuit et sans engagement.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
              <svg class="w-5 h-5 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Certifié RGE
            </div>
            <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
              <svg class="w-5 h-5 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              Aides financières
            </div>
            <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
              <svg class="w-5 h-5 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
              </svg>
              Attestation incluse
            </div>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="w-full lg:w-5/12">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-video lg:aspect-[4/3] bg-gray-100">
            <img
              src="https://images.unsplash.com/photo-1585771724684-38269d6639fd?w=800&h=600&fit=crop"
              alt="Technicien chauffagiste effectuant l'entretien d'une chaudière"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <p class="text-sm font-semibold bg-orange-600/90 inline-block px-3 py-1 rounded mb-1">Entretien en cours</p>
              <p class="text-xs opacity-90">Vérification complète et réglages de performance.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left Column (Main Content) -->
      <div class="lg:col-span-8 space-y-16">
        <!-- Services -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <span class="w-8 h-8 rounded bg-orange-100 text-orange-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
              </svg>
            </span>
            Nos services chauffage
          </h2>
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <p class="mb-6 text-gray-600">De l'entretien obligatoire au remplacement complet, nous prenons en charge tous vos besoins en chauffage.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8">
              {services.map((item) => (
                <div class="flex gap-x-3 items-start p-2 rounded hover:bg-gray-50 transition-colors">
                  <div class="flex items-center">
                    <svg class="w-5 h-5 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="text-sm leading-6">
                    <span class="font-medium text-gray-900">{item.title}</span>
                    <p class="text-gray-500 text-xs">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Why Choose Us -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Pourquoi nous choisir ?</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {whyChooseUs.map((item) => (
              <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-lg transition-shadow">
                <div class="w-12 h-12 rounded-full bg-orange-50 text-orange-600 flex items-center justify-center mb-4">
                  {item.icon === 'certificate' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                    </svg>
                  )}
                  {item.icon === 'brands' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                  )}
                  {item.icon === 'contract' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  )}
                  {item.icon === 'eco' && (
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  )}
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-sm text-gray-600">{item.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Pricing Table -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Tarifs Chauffage</h2>
          <PricingTable items={pricing} />
        </section>

        <!-- FAQ -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Questions Fréquentes</h2>
          <FAQAccordion items={faq} />
        </section>
      </div>

      <!-- Right Column (Sticky Sidebar) -->
      <div class="lg:col-span-4">
        <SidebarContact />
      </div>
    </div>
  </div>
</Layout>
