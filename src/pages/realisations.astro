---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Réalisations' }
];

const categories = [
  { id: 'all', label: 'Toutes', active: true },
  { id: 'urgence', label: 'Urgences', active: false },
  { id: 'chauffage', label: 'Chauffage', active: false },
  { id: 'plomberie', label: 'Plomberie', active: false },
  { id: 'renovation', label: 'Rénovation', active: false }
];

const realisations = [
  {
    slug: 'reparation-fuite-eau-majeure',
    title: 'Réparation Fuite d\'Eau Majeure',
    category: 'Urgence',
    categoryColor: 'bg-red-600',
    date: '14 Février 2024',
    duration: 'Intervention 45min',
    durationClass: 'text-red-600',
    location: 'Rambouillet Centre',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=450&fit=crop',
    verified: true
  },
  {
    slug: 'installation-douche-italienne',
    title: 'Installation Douche Italienne',
    category: 'Rénovation',
    categoryColor: 'bg-blue-600',
    date: '28 Janvier 2024',
    duration: 'Durée: 3 jours',
    durationClass: 'text-gray-500',
    location: 'Gazeran',
    image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=450&fit=crop',
    verified: true
  },
  {
    slug: 'remplacement-chaudiere-gaz',
    title: 'Remplacement Chaudière Gaz',
    category: 'Chauffage',
    categoryColor: 'bg-orange-600',
    date: '10 Janvier 2024',
    duration: 'Mise en service',
    durationClass: 'text-gray-500',
    location: 'Le Perray-en-Yvelines',
    image: 'https://images.unsplash.com/photo-1585771724684-38269d6639fd?w=600&h=450&fit=crop',
    verified: true
  },
  {
    slug: 'raccordement-cuisine-neuve',
    title: 'Raccordement Cuisine Neuve',
    category: 'Plomberie',
    categoryColor: 'bg-gray-700',
    date: '15 Décembre 2023',
    duration: 'Installation',
    durationClass: 'text-gray-500',
    location: 'Rambouillet - La Clairière',
    image: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=450&fit=crop',
    verified: false
  },
  {
    slug: 'debouchage-wc-canalisations',
    title: 'Débouchage WC & Canalisations',
    category: 'Urgence',
    categoryColor: 'bg-red-600',
    date: '02 Décembre 2023',
    duration: 'Intervention 30min',
    durationClass: 'text-red-600',
    location: 'Clairefontaine-en-Yvelines',
    image: 'https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=600&h=450&fit=crop',
    verified: true
  },
  {
    slug: 'installation-chauffe-eau-thermodynamique',
    title: 'Installation Chauffe-eau Thermodynamique',
    category: 'Chauffage',
    categoryColor: 'bg-blue-600',
    date: '20 Novembre 2023',
    duration: 'Remplacement',
    durationClass: 'text-gray-500',
    location: 'Sonchamp',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=450&fit=crop',
    verified: true
  }
];

const portfolioSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Réalisations Plomberie Rambouillet",
  "description": "Découvrez nos réalisations en plomberie et chauffage à Rambouillet : urgences, rénovations salle de bain, installations de chaudières.",
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://www.rambouillet-plomberie.fr/#website"
  }
};
---

<Layout
  title="Nos Réalisations - Plomberie & Chauffage Rambouillet | Portfolio"
  description="Découvrez nos réalisations en plomberie et chauffage à Rambouillet : urgences, rénovations salle de bain, installations chaudières. Photos avant/après."
  schema={portfolioSchema}
>
  <!-- Page Heading -->
  <section class="relative py-12 md:py-20 overflow-hidden bg-white border-b border-gray-200">
    <div class="absolute -top-20 -right-20 -z-10 h-96 w-96 rounded-full bg-blue-100/50 blur-3xl"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-600 mb-4 border border-blue-100">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
            </span>
            Interventions 24/7
          </div>
          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
            Nos Réalisations & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-400">Interventions</span>
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed max-w-xl">
            Découvrez la qualité de notre savoir-faire à Rambouillet. Du simple dépannage d'urgence à la rénovation complète de salle de bain, nous documentons notre expertise.
          </p>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="mt-12 flex flex-wrap items-center gap-3 border-b border-gray-200 pb-6">
        {categories.map((cat) => (
          <button
            class={`rounded-full px-5 py-2.5 text-sm font-semibold transition-all ${
              cat.active
                ? 'bg-blue-600 text-white shadow-md ring-2 ring-blue-600 ring-offset-2'
                : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-gray-300'
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-12 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {realisations.map((item) => (
          <article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <a href={`/realisations/${item.slug}`} class="absolute inset-0 z-10">
              <span class="sr-only">Voir {item.title}</span>
            </a>
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-100">
              <div class={`absolute top-4 left-4 z-10 flex items-center gap-1 rounded-full ${item.categoryColor}/90 backdrop-blur-sm px-3 py-1 text-xs font-bold text-white shadow-sm`}>
                {item.category === 'Urgence' && (
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                )}
                {item.category}
              </div>
              <img
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-blue-600/20 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
            <div class="flex flex-col p-6">
              <div class="mb-3 flex items-center justify-between text-xs font-medium text-gray-500">
                <span>{item.date}</span>
                <span class={item.durationClass}>{item.duration}</span>
              </div>
              <h3 class="mb-2 text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">{item.title}</h3>
              <div class="mt-auto flex items-center gap-2 pt-3 border-t border-gray-100 text-sm text-gray-600">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>{item.location}</span>
                {item.verified && (
                  <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Load More Button -->
      <div class="mt-16 flex justify-center">
        <button class="flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-50">
          Charger plus de projets
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-blue-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        Vous avez un projet similaire ?
      </h2>
      <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
        Contactez-nous pour un devis gratuit et sans engagement. Nous intervenons dans tout le secteur de Rambouillet.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:+33627313870"
          class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-xl font-semibold text-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          06 27 31 38 70
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-transparent hover:bg-white/10 text-white px-8 py-4 rounded-xl font-semibold text-lg border-2 border-white/30 transition-colors"
        >
          Demander un devis
        </a>
      </div>
    </div>
  </section>
</Layout>
