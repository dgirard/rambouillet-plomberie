---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SidebarContact from '../../components/ui/SidebarContact.astro';

const breadcrumbs = [
  { label: 'Réalisations', href: '/realisations' },
  { label: 'Réparation Fuite d\'Eau' }
];

const project = {
  title: 'Réparation de Fuite Eau Importante',
  subtitle: 'Rambouillet Centre',
  category: 'Urgence',
  location: 'Rambouillet (78)',
  duration: '45 minutes',
  date: 'Février 2024',
  propertyType: 'Appartement',
  brands: 'Grohe, Geberit',
  budget: 'Forfait Urgence',
  mainImage: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1200&h=800&fit=crop',
  thumbnails: [
    'https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=400&h=300&fit=crop',
    'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=300&fit=crop',
    'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&h=300&fit=crop'
  ],
  context: "Le client nous a contactés en urgence un samedi matin suite à une fuite d'eau importante au niveau de son évier de cuisine. L'eau s'infiltrait sous le plan de travail et menaçait d'endommager les meubles. Une intervention rapide était cruciale pour limiter les dégâts.",
  diagnosis: [
    "Joint du siphon usé et poreux, laissant passer l'eau à chaque utilisation",
    "Flexible d'alimentation du mitigeur fissuré au niveau du raccord"
  ],
  solution: "Nous avons procédé au remplacement complet du siphon par un modèle inox haute qualité et changé les deux flexibles d'alimentation. Vérification de l'ensemble de la robinetterie et test d'étanchéité complet.",
  tips: [
    { title: "Surveillance mensuelle", text: "Vérifiez régulièrement l'état des joints sous votre évier. Un joint humide ou noirci doit être remplacé." },
    { title: "Qualité des flexibles", text: "Privilégiez les flexibles inox tressé, ils durent 10 ans contre 3-5 ans pour les flexibles caoutchouc." }
  ],
  testimonial: {
    text: "Intervention ultra rapide et efficace. Le plombier est arrivé en 20 minutes un samedi ! Travail soigné et prix raisonnable. Je recommande !",
    author: "Philippe R.",
    location: "Rambouillet Centre",
    initials: "PR",
    rating: 5
  }
};

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": project.title,
  "description": project.context,
  "datePublished": "2024-02-14",
  "author": {
    "@type": "Organization",
    "name": "Plomberie Rambouillet Services"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://www.sdepannageplomberie.com/#organization"
  }
};
---

<Layout
  title={`${project.title} à ${project.subtitle} | Plomberie Rambouillet`}
  description={`Découvrez notre intervention d'urgence : ${project.title} à ${project.location}. Photos avant/après et détails de la réparation.`}
  schema={projectSchema}
>
  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        {project.title} - {project.subtitle}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm font-medium text-gray-500">
        <span class="flex items-center gap-1.5 bg-red-50 text-red-600 px-3 py-1 rounded-full border border-red-100">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
          </svg>
          {project.category}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {project.location}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Durée: {project.duration}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {project.date}
        </span>
      </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Content Column -->
      <div class="lg:col-span-8 space-y-12">
        <!-- Gallery Section -->
        <div class="space-y-4">
          <div class="w-full aspect-video rounded-xl overflow-hidden shadow-lg relative group">
            <img
              src={project.mainImage}
              alt={project.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider text-gray-800 shadow-sm">
              Après intervention
            </div>
          </div>
          <div class="grid grid-cols-3 gap-4">
            {project.thumbnails.map((thumb, index) => (
              <div class="aspect-[4/3] rounded-lg overflow-hidden cursor-pointer hover:opacity-90 transition-opacity border-2 border-transparent hover:border-blue-600">
                <img src={thumb} alt={`Photo ${index + 1}`} class="w-full h-full object-cover" />
              </div>
            ))}
          </div>
        </div>

        <!-- Context Section -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
            <span class="bg-blue-100 text-blue-600 p-1.5 rounded-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </span>
            Contexte
          </h2>
          <p class="text-gray-600 leading-relaxed text-lg">
            {project.context}
          </p>
        </section>

        <!-- Diagnosis Section -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
            <span class="bg-blue-100 text-blue-600 p-1.5 rounded-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </span>
            Diagnostic
          </h2>
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <p class="text-gray-600 mb-4">
              Après inspection complète, nous avons identifié les problèmes suivants :
            </p>
            <ul class="space-y-3">
              {project.diagnosis.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Solution Section -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
            <span class="bg-blue-100 text-blue-600 p-1.5 rounded-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            Solution apportée
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            {project.solution}
          </p>
          <div class="flex items-center gap-2 text-sm font-semibold text-green-600 bg-green-50 w-fit px-4 py-2 rounded-full">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Garantie Pièces et Main d'œuvre incluse
          </div>
        </section>

        <!-- Pro Advice Box -->
        <div class="bg-blue-50 border-l-4 border-blue-600 p-6 md:p-8 rounded-r-xl">
          <h3 class="text-xl font-bold text-blue-600 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"/>
            </svg>
            Conseils du Pro
          </h3>
          <ul class="space-y-4">
            {project.tips.map((tip) => (
              <li class="flex items-start gap-3">
                <div class="bg-blue-600 text-white rounded-full p-0.5 mt-0.5 flex-shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-gray-700"><strong>{tip.title} :</strong> {tip.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Sidebar Column -->
      <div class="lg:col-span-4 space-y-8">
        <!-- Project Summary Card -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b border-gray-100">Fiche Intervention</h3>
          <dl class="space-y-4">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Type de bien</dt>
              <dd class="text-gray-900 font-medium">{project.propertyType}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Marques utilisées</dt>
              <dd class="text-gray-900 font-medium">{project.brands}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500">Budget approximatif</dt>
              <dd class="text-gray-900 font-medium">{project.budget}</dd>
            </div>
          </dl>
        </div>

        <!-- Testimonial Card -->
        <div class="bg-gray-900 rounded-xl p-6 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 -mr-4 -mt-4 text-gray-700 opacity-20">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>
          <div class="flex gap-1 text-yellow-400 mb-3">
            {[...Array(project.testimonial.rating)].map(() => (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <blockquote class="italic text-gray-200 mb-4 relative z-10">
            "{project.testimonial.text}"
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-gray-700 flex items-center justify-center font-bold text-sm">{project.testimonial.initials}</div>
            <div>
              <div class="font-bold text-sm">{project.testimonial.author}</div>
              <div class="text-gray-400 text-xs">{project.testimonial.location}</div>
            </div>
          </div>
        </div>

        <!-- Sticky CTA Widget -->
        <SidebarContact />
      </div>
    </div>

    <!-- Bottom CTA Section -->
    <section class="mt-20 mb-12">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl p-8 md:p-12 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl overflow-hidden relative">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl -mr-16 -mt-16 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl -ml-16 -mb-16 pointer-events-none"></div>
        <div class="relative z-10 max-w-xl">
          <h2 class="text-3xl font-extrabold text-white mb-4">Un problème similaire ?</h2>
          <p class="text-gray-300 text-lg">Ne laissez pas une petite fuite devenir un dégât des eaux majeur. Obtenez un diagnostic gratuit par téléphone.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 relative z-10 w-full md:w-auto">
          <a
            href="tel:+33627313870"
            class="flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white text-lg font-bold py-4 px-8 rounded-xl shadow-lg transition-transform hover:-translate-y-1"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            06 27 31 38 70
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center gap-2 bg-transparent hover:bg-white/10 text-white border-2 border-white/20 hover:border-white font-bold py-4 px-8 rounded-xl transition-all"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Demander un devis
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
