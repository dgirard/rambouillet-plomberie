---
const phone = '06 27 31 38 70';
const phoneLink = 'tel:+33627313870';
const whatsappLink = 'https://wa.me/33627313870?text=Bonjour%2C%20j%27ai%20besoin%20d%27un%20plombier';
---

<div class="sticky top-24 space-y-6">
  <!-- Main Contact Card -->
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6 text-center relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-red-600"></div>
    <h3 class="text-xl font-bold text-gray-900 mb-2">Besoin d'un dépannage ?</h3>
    <p class="text-sm text-gray-500 mb-6">Nos experts sont en ligne. Réponse immédiate.</p>

    <!-- Phone Button -->
    <a
      href={phoneLink}
      class="flex flex-col items-center justify-center w-full bg-red-600 hover:bg-red-700 text-white rounded-xl py-4 mb-3 transition-colors group"
    >
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span class="text-xs font-semibold uppercase tracking-wider opacity-90">Appel d'urgence</span>
      </div>
      <span class="text-2xl font-black tracking-wider mt-1 group-hover:scale-105 transition-transform">{phone}</span>
    </a>

    <!-- WhatsApp Button -->
    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-2 w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl transition-colors"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>

  <!-- Zone d'intervention -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-100 bg-gray-50">
      <h4 class="font-bold text-gray-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
        </svg>
        Zone d'intervention
      </h4>
    </div>
    <div class="relative h-40 bg-gradient-to-br from-blue-50 to-blue-100">
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="w-24 h-24 bg-blue-200/50 rounded-full flex items-center justify-center animate-pulse">
          <span class="w-3 h-3 bg-blue-600 rounded-full border-2 border-white shadow-lg"></span>
        </span>
      </div>
      <div class="absolute bottom-2 left-2 text-xs text-blue-600 font-medium">Rambouillet (78)</div>
    </div>
    <div class="p-4">
      <ul class="space-y-3">
        <li class="flex items-start gap-3 text-sm text-gray-600">
          <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Rambouillet Centre <span class="text-xs font-semibold text-green-600 bg-green-100 px-1.5 py-0.5 rounded ml-1">15 min</span></span>
        </li>
        <li class="flex items-start gap-3 text-sm text-gray-600">
          <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Gazeran, Sonchamp, Le Perray <span class="text-xs font-semibold text-green-600 bg-green-100 px-1.5 py-0.5 rounded ml-1">30 min</span></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Trust Badge -->
  <div class="bg-blue-50 rounded-xl p-4 border border-blue-100 flex items-center gap-4">
    <div class="bg-white p-2 rounded-full shadow-sm text-yellow-500">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-gray-900">4.9/5 Avis Clients</p>
      <p class="text-xs text-gray-500">Basé sur 150+ interventions</p>
    </div>
  </div>
</div>
