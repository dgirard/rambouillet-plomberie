---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex mb-6">
  <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm font-medium">
    <li class="inline-flex items-center">
      <a class="text-gray-500 hover:text-blue-600" href="/">Accueil</a>
    </li>
    {items.map((item, index) => (
      <li>
        <div class="flex items-center">
          <svg class="w-4 h-4 text-gray-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          {item.href ? (
            <a class="text-gray-500 hover:text-blue-600" href={item.href}>{item.label}</a>
          ) : (
            <span class="text-blue-600 font-semibold">{item.label}</span>
          )}
        </div>
      </li>
    ))}
  </ol>
</nav>
