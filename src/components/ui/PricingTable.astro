---
interface PricingItem {
  service: string;
  details: string;
  price: string;
  isUrgent?: boolean;
}

interface Props {
  items: PricingItem[];
}

const { items } = Astro.props;
---

<div class="overflow-hidden bg-white rounded-xl border border-gray-200 shadow-sm">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider" scope="col">Service</th>
        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider hidden sm:table-cell" scope="col">Détails</th>
        <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider" scope="col">Tarif TTC</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      {items.map((item) => (
        <tr class={item.isUrgent ? 'bg-red-50/50' : ''}>
          <td class={`px-6 py-4 whitespace-nowrap text-sm font-medium ${item.isUrgent ? 'text-red-600 font-bold' : 'text-gray-900'}`}>
            {item.service}
          </td>
          <td class="px-6 py-4 text-sm text-gray-500 hidden sm:table-cell">
            {item.details}
          </td>
          <td class={`px-6 py-4 whitespace-nowrap text-sm text-right font-bold ${item.isUrgent ? 'text-red-600' : 'text-blue-600'}`}>
            {item.price}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="px-6 py-3 bg-gray-50 border-t border-gray-200">
    <p class="text-xs text-gray-500">* Les tarifs sont donnés à titre indicatif et peuvent varier selon la complexité.</p>
  </div>
</div>
