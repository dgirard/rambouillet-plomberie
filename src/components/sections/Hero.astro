---
const phone = '06 27 31 38 70';
const phoneLink = 'tel:+33627313870';
---

<section class="relative bg-gradient-to-br from-gray-50 to-blue-50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Content -->
      <div class="order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          Disponible maintenant sur Rambouillet (78)
        </div>

        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-gray-900 leading-tight mb-6">
          Plombier Rambouillet
          <span class="text-blue-600 block">Dépannage 24/7</span>
        </h1>

        <p class="text-lg text-gray-600 mb-8 max-w-lg">
          Intervention en 30 min. Devis gratuit et sans surprise. Votre artisan de confiance pour les fuites, chaudières et rénovations.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a
            href={phoneLink}
            class="inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white px-6 py-4 rounded-xl font-semibold text-lg transition-colors shadow-lg shadow-red-600/25"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Appeler maintenant
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-gray-900 px-6 py-4 rounded-xl font-semibold text-lg border-2 border-gray-200 transition-colors"
          >
            Demander un devis
          </a>
        </div>

        <div class="flex flex-wrap gap-6 text-sm text-gray-600">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Agréé Assurances</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Artisans Qualifiés</span>
          </div>
        </div>
      </div>

      <!-- Image -->
      <div class="order-1 lg:order-2 relative">
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=800&h=600&fit=crop"
            alt="Plombier professionnel au travail à Rambouillet"
            class="w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-6">
            <div class="flex items-center gap-3">
              <div class="flex -space-x-2">
                <div class="w-8 h-8 rounded-full bg-blue-500 border-2 border-white"></div>
                <div class="w-8 h-8 rounded-full bg-green-500 border-2 border-white"></div>
                <div class="w-8 h-8 rounded-full bg-orange-500 border-2 border-white"></div>
              </div>
              <div class="text-white">
                <div class="flex items-center gap-1">
                  <span class="font-semibold">150+</span>
                  <span class="text-yellow-400">★★★★★</span>
                </div>
                <p class="text-sm text-white/80">Clients satisfaits</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
