---
const reviews = [
  {
    text: "Rapide et efficace, le plombier est arrivé en 20 minutes un dimanche pour une fuite importante. Travail très propre.",
    author: "Sophie M.",
    location: "Rambouillet",
    initials: "SM",
    rating: 5
  },
  {
    text: "Devis respecté à la lettre pour le remplacement de ma chaudière. Je recommande vivement pour le sérieux.",
    author: "Pierre L.",
    location: "Gazeran",
    initials: "PL",
    rating: 5
  },
  {
    text: "Très bon contact, explication claire du problème et réparation solide. Enfin un artisan de confiance !",
    author: "Julie D.",
    location: "Clairefontaine",
    initials: "JD",
    rating: 5
  }
];
---

<section class="py-16 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        Ce que nos clients disent
      </h2>
      <p class="text-gray-600">
        La satisfaction de nos clients est notre meilleure publicité
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {reviews.map((review) => (
        <article class="bg-gray-50 rounded-2xl p-6 lg:p-8">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {[...Array(review.rating)].map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-gray-700 mb-6 leading-relaxed">
            "{review.text}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-semibold text-sm">
              {review.initials}
            </div>
            <div>
              <p class="font-semibold text-gray-900">{review.author}</p>
              <p class="text-sm text-gray-500">{review.location}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
