---
const googleMapsUrl = "https://maps.app.goo.gl/KUM8uS9mUC6qdjyn9";

const business = {
  name: "S Dépannage plomberie",
  rating: 5.0,
  reviewCount: 12,
  placeId: "ChIJtUVhAVp4-0cRXeqFeOmDqkQ"
};

// Avis clients à mettre à jour manuellement depuis Google Maps
const reviews = [
  {
    author: "Marc D.",
    rating: 5,
    date: "Il y a 2 semaines",
    text: "Équipe très réactive ! J'ai appelé pour une fuite sous mon évier, le plombier était là en 10 minutes. Travail soigné et prix très correct. Je recommande les yeux fermés.",
    avatar: "MD"
  },
  {
    author: "Sophie L.",
    rating: 5,
    date: "Il y a 1 mois",
    text: "Intervention rapide pour un débouchage de canalisation. Professionnel, ponctuel et efficace. Le tarif annoncé a été respecté. Merci !",
    avatar: "SL"
  },
  {
    author: "Pierre M.",
    rating: 5,
    date: "Il y a 2 mois",
    text: "Excellent service pour la réparation de mon chauffe-eau. Diagnostic précis, réparation rapide. Je recommande vivement ce plombier sérieux et compétent.",
    avatar: "PM"
  }
];

// Génère les étoiles
const renderStars = (rating: number) => {
  return Array(5).fill(0).map((_, i) => i < rating);
};
---

<section class="py-16 lg:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 shadow-sm mb-6">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span class="text-sm font-semibold text-gray-700">Avis Google</span>
      </div>

      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        Ce que disent nos clients
      </h2>

      <!-- Rating Summary -->
      <div class="flex items-center justify-center gap-4 mb-2">
        <div class="flex items-center gap-1">
          {renderStars(business.rating).map((filled) => (
            <svg class={`w-6 h-6 ${filled ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="text-2xl font-bold text-gray-900">{business.rating}</span>
        <span class="text-gray-500">({business.reviewCount} avis)</span>
      </div>

      <p class="text-gray-600">
        Basé sur les avis Google de <span class="font-semibold">{business.name}</span>
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {reviews.map((review) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-lg transition-shadow">
          <!-- Header -->
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">
                {review.avatar}
              </div>
              <div>
                <p class="font-semibold text-gray-900">{review.author}</p>
                <p class="text-xs text-gray-500">{review.date}</p>
              </div>
            </div>
            <svg class="w-6 h-6 text-gray-300" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>

          <!-- Stars -->
          <div class="flex items-center gap-1 mb-3">
            {renderStars(review.rating).map((filled) => (
              <svg class={`w-4 h-4 ${filled ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Review Text -->
          <p class="text-gray-600 text-sm leading-relaxed">
            "{review.text}"
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-white border-2 border-gray-200 rounded-xl font-semibold text-gray-900 hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm hover:shadow-md"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Voir tous les avis sur Google
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>

      <p class="mt-4 text-sm text-gray-500">
        Laissez-nous votre avis sur Google Maps
      </p>
    </div>
  </div>
</section>
