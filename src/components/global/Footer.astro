---
const currentYear = new Date().getFullYear();

const services = [
  { href: '/urgences', label: 'Dépannage Urgence' },
  { href: '/plomberie', label: 'Plomberie Générale' },
  { href: '/realisations', label: 'Nos Réalisations' },
  { href: '/contact', label: 'Contact & Devis' },
];

const zones = [
  { href: '/zones/rambouillet', label: 'Rambouillet' },
  { href: '/zones/versailles', label: 'Versailles' },
  { href: '/zones/saint-quentin-en-yvelines', label: 'Saint-Quentin-en-Yvelines' },
  { href: '/zones/les-essarts-le-roi', label: 'Les Essarts-le-Roi' },
  { href: '/zones/le-perray-en-yvelines', label: 'Le Perray-en-Yvelines' },
  { href: '/zones/auffargis', label: 'Auffargis' },
  { href: '/zones/ablis', label: 'Ablis' },
  { href: '/zones/orphin', label: 'Orphin' },
  { href: '/zones/gazeran', label: 'Gazeran' },
  { href: '/zones/sonchamp', label: 'Sonchamp' },
  { href: '/zones/clairefontaine-en-yvelines', label: 'Clairefontaine' },
  { href: '/zones/saint-arnoult-en-yvelines', label: 'Saint-Arnoult' },
];

const legal = [
  { href: '/mentions-legales', label: 'Mentions Légales' },
  { href: '/politique-confidentialite', label: 'Politique de confidentialité' },
];
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <span class="font-bold text-white">Plomberie Rambouillet</span>
        </a>
        <p class="text-sm text-gray-400 mb-4">
          Votre partenaire confiance pour tous travaux de plomberie dans les Yvelines (78). Disponibilité 24/7.
        </p>
        <div class="flex gap-3">
          <a href="https://www.facebook.com" target="_blank" rel="noopener" class="w-9 h-9 bg-gray-800 rounded-lg flex items-center justify-center hover:bg-gray-700 transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5h-4.33C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com" target="_blank" rel="noopener" class="w-9 h-9 bg-gray-800 rounded-lg flex items-center justify-center hover:bg-gray-700 transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12,2.16c3.2,0,3.58.01,4.85.07,1.17.05,1.8.25,2.23.41.56.22.96.48,1.38.9s.68.82.9,1.38c.16.42.36,1.06.41,2.23.06,1.27.07,1.65.07,4.85s-.01,3.58-.07,4.85c-.05,1.17-.25,1.8-.41,2.23-.22.56-.48.96-.9,1.38s-.82.68-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9s-.68-.82-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38s.82-.68,1.38-.9c.42-.16,1.06-.36,2.23-.41,1.27-.06,1.65-.07,4.85-.07M12,0C8.74,0,8.33.01,7.05.07,5.78.13,4.9.33,4.14.63c-.78.3-1.44.71-2.1,1.37S.93,3.36.63,4.14C.33,4.9.13,5.78.07,7.05.01,8.33,0,8.74,0,12s.01,3.67.07,4.95c.06,1.27.26,2.15.56,2.91.3.78.71,1.44,1.37,2.1s1.32,1.07,2.1,1.37c.76.3,1.64.5,2.91.56,1.28.06,1.69.07,4.95.07s3.67-.01,4.95-.07c1.27-.06,2.15-.26,2.91-.56.78-.3,1.44-.71,2.1-1.37s1.07-1.32,1.37-2.1c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.78-.71-1.44-1.37-2.1S20.64.93,19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01,15.26,0,12,0Z"/>
              <path d="M12,5.84A6.16,6.16,0,1,0,18.16,12,6.16,6.16,0,0,0,12,5.84ZM12,16a4,4,0,1,1,4-4A4,4,0,0,1,12,16Z"/>
              <circle cx="18.41" cy="5.59" r="1.44"/>
            </svg>
          </a>
          <a href="https://www.snapchat.com/add/souleydepannage" target="_blank" rel="noopener" class="w-9 h-9 bg-gray-800 rounded-lg flex items-center justify-center hover:bg-gray-700 transition-colors" aria-label="Snapchat">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.21,21.7c-.1,0-.2,0-.3,0a4.2,4.2,0,0,1-2.42-.83,7.4,7.4,0,0,0-1.37-.74,3.48,3.48,0,0,0-.94-.17,6.56,6.56,0,0,0-1.2.15l-.4.08a.9.9,0,0,1-.17,0,.54.54,0,0,1-.55-.5.51.51,0,0,1,.34-.55l.16-.06a8.68,8.68,0,0,0,1.59-.72,3,3,0,0,0,1.12-1.16.65.65,0,0,0-.14-.78l-.12-.1A6.08,6.08,0,0,1,6,13.7a5.92,5.92,0,0,1-.55-1.83,2.49,2.49,0,0,1,.62-2.06.53.53,0,0,1,.58-.15.54.54,0,0,1,.37.47,1.65,1.65,0,0,0,.17.53,1.32,1.32,0,0,0,.26-.43,12,12,0,0,1,.39-3.91A5.52,5.52,0,0,1,12.09,2.3h.06A5.49,5.49,0,0,1,16.4,6.35a11.76,11.76,0,0,1,.39,3.87,1.38,1.38,0,0,0,.27.44,1.45,1.45,0,0,0,.17-.53.54.54,0,0,1,.37-.47.53.53,0,0,1,.58.15,2.48,2.48,0,0,1,.63,2.06,5.89,5.89,0,0,1-.55,1.83,6.15,6.15,0,0,1-1.79,2.62l-.12.1a.64.64,0,0,0-.14.77,3,3,0,0,0,1.12,1.17,8.75,8.75,0,0,0,1.59.72l.16.06a.51.51,0,0,1,.34.55.54.54,0,0,1-.55.5.9.9,0,0,1-.17,0l-.4-.08a6.56,6.56,0,0,0-1.2-.15,3.48,3.48,0,0,0-.94.17,7.55,7.55,0,0,0-1.37.74,4.2,4.2,0,0,1-2.42.83C12.41,21.7,12.31,21.7,12.21,21.7Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Rambouillet et Yvelines (78)</span>
          </li>
          <li>
            <a href="tel:+33627313870" class="flex items-start gap-3 hover:text-white transition-colors">
              <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>06 27 31 38 70</span>
            </a>
          </li>
          <li>
            <a href="mailto:S.depannage.plomberie@gmail.com" class="flex items-start gap-3 hover:text-white transition-colors">
              <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>S.depannage.plomberie@gmail.com</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">Services</h3>
        <ul class="space-y-2 text-sm">
          {services.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Zones & Legal -->
      <div>
        <h3 class="text-white font-semibold mb-4">Zones d'intervention</h3>
        <ul class="space-y-2 text-sm mb-6">
          {zones.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-4 border-t border-gray-800">
          <p class="text-xs text-gray-500 mb-2">Certifications</p>
          <p class="text-sm font-medium text-white">Garantie Décennale</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-gray-500">
          &copy; {currentYear} Plomberie Rambouillet Services. Tous droits réservés.
        </p>
        <div class="flex gap-6 text-sm">
          {legal.map((link) => (
            <a href={link.href} class="text-gray-500 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
